# ==========================================
# RORRAXY ENTERPRISE ENVIRONMENT CONFIG
# ==========================================

# Application Environment (development / production)
NODE_ENV=production

# Master Domain Configuration
SITE_URL=https://rorraxy.com

# Cloudflare D1 Database Configuration (Backend bindings)
# DB_ID আপনার ক্লাউডফ্লেয়ার ড্যাশবোর্ড থেকে পাবেন
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id_here

# Cloudflare R2 Object Storage Configuration (Media & Videos)
CLOUDFLARE_R2_BUCKET_NAME=rorraxy-media-storage
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
CLOUDFLARE_R2_PUBLIC_URL=https://r2.rorraxy.com

# Security & Encryption Keys
JWT_SECRET_KEY=generate_a_very_strong_random_secret_key_here
CSRF_SECRET_TOKEN=generate_a_secure_csrf_token_here

# Payment & Merchant Gateway Integration (PingPong / Payoneer / Local)
PAYMENT_GATEWAY_MODE=live
MERCHANT_API_KEY=your_merchant_api_key_here
